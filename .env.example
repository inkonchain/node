###############################################################################
#                                ↓ REQUIRED ↓                                 #
###############################################################################

# Network to run: ink-mainnet or ink-sepolia.
NETWORK_NAME=ink-sepolia

# "full" prunes old state and starts from the latest full op-reth snapshot.
# "archive" keeps all history and starts from the latest archive snapshot.
# Snapshots are downloaded from https://snapshots.optimism.io/ on first run.
NODE_TYPE=full

# After the snapshot is restored, op-node derives the chain from L1 starting at
# the snapshot date (up to about a week back). Use an L1 provider that serves
# receipts for old blocks (eth_getBlockReceipts) and has high rate limits.
# Free public endpoints were tested against Ink Sepolia and are not enough:
# - ethereum-sepolia-rpc.publicnode.com returns no receipts for older blocks
# - sepolia.gateway.tenderly.co returns 429 Too Many Requests
# - sepolia.drpc.org only allows batches of 3 (set OP_NODE_L1_RPC_MAX_BATCH_SIZE=3)
#   and still catches up slower than the chain advances

# L1 execution RPC endpoint for the matching Ethereum network
OP_NODE__RPC_ENDPOINT=

# L1 beacon API endpoint for the matching Ethereum network
OP_NODE__L1_BEACON=

# Optional: cap op-node's L1 batch request size for providers that limit
# batches (default 20). Read directly by op-node; op-reth ignores it.
# OP_NODE_L1_RPC_MAX_BATCH_SIZE=3

# Use "basic" for generic providers. Other supported values are alchemy,
# quicknode, and erigon.
OP_NODE__RPC_TYPE=basic

# L2 RPC used by the healthcheck sidecar for comparison.
# The per-network env files provide defaults, and this value overrides them.
# For ink-mainnet, switch this to https://rpc-gel.inkonchain.com
HEALTHCHECK__REFERENCE_RPC_PROVIDER=https://rpc-gel-sepolia.inkonchain.com

###############################################################################
#                                ↓ OPTIONAL ↓                                 #
###############################################################################

# Optional image tag overrides for sidecars
IMAGE_TAG__HEALTHCHECK=
IMAGE_TAG__PROMETHEUS=
IMAGE_TAG__GRAFANA=

# Exposed host ports (must be unique). Set these only if the defaults clash.
PORT__HEALTHCHECK_METRICS=
PORT__PROMETHEUS=
PORT__GRAFANA=
PORT__OP_RETH_HTTP=
PORT__OP_RETH_WS=
PORT__OP_RETH_P2P=
# PORT__OP_NODE_P2P changes the published host port. The in-container
# op-node listener still uses 9003.
PORT__OP_NODE_P2P=
PORT__OP_NODE_HTTP=

# Advanced wrapper inputs shared by the shell entrypoints. Leave blank unless
# you know you need them.
# OVERRIDE_HOLOCENE appends --override.holocene=<value> to op-node only.
OVERRIDE_HOLOCENE=

# EXTENDED_ARG is appended verbatim to both start commands (op-node and
# op-reth). Only use flags that are valid for the process you want to affect.
EXTENDED_ARG=
