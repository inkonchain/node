FROM ubuntu:22.04

# Disable prompts during package installation.
ARG DEBIAN_FRONTEND=noninteractive

# Install required packages.
# Only what the init scripts call: curl, openssl (JWT), aria2c (utils.sh
# download), unzstd/lz4 (utils.sh extractors) and coreutils/tar from the base
# image. git/wget/rsync/build-essential/python3 were unused.
RUN apt-get update && apt install -y --no-install-recommends curl ca-certificates openssl aria2 zstd lz4 && rm -rf /var/lib/apt/lists/*
